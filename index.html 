<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>THE BACKROOMS: 50 REALITIES</title>
    <style>
        body, html { margin: 0; padding: 0; overflow: hidden; background-color: #020202; font-family: 'Courier New', monospace; user-select: none; width: 100vw; height: 100vh; }
        #game-canvas { width: 100%; height: 100%; display: block; }
        #hud-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; display: flex; flex-direction: column; justify-content: space-between; padding: 25px; box-sizing: border-box; color: #ebdcb2; text-shadow: 2px 2px 4px #000; z-index: 10; }
        .panel { background: rgba(15, 15, 10, 0.9); border: 2px solid #7d6b47; padding: 12px; border-radius: 6px; pointer-events: auto; }
        .bar-outer { width: 180px; height: 12px; background: #1a1a14; border: 1px solid #54472f; margin-top: 4px; border-radius: 2px; overflow: hidden; }
        .bar-inner { height: 100%; width: 100%; transition: width 0.1s linear; }
        #stamina-bar { background: #2cd6a1; }
        #sanity-bar { background: #ff4747; }
        #battery-bar { background: #ffcc00; }
        .input-flat { background: #14140f; border: 1px solid #7d6b47; color: #fff; padding: 6px; font-family: monospace; width: 130px; }
        button { background: #7d6b47; color: #fff; border: 1px solid #ebdcb2; padding: 6px 12px; cursor: pointer; font-family: monospace; font-weight: bold; border-radius: 4px; }
        #crosshair { position: absolute; top: 50%; left: 50%; width: 6px; height: 6px; background: rgba(255,255,255,0.4); border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; }
        #vr-btn-container { position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); z-index: 100; }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/webxr/VRButton.js"></script>
    <script src="https://unpkg.com/peerjs@1.4.7/dist/peerjs.min.js"></script>
</head>
<body>

    <canvas id="game-canvas"></canvas>

    <div id="hud-layer">
        <div style="display: flex; justify-content: space-between; width: 100%; pointer-events: none;">
            <div class="panel">
                <div style="font-weight: bold; color:#ffcc00;">EXPLORACIÓN P2P</div>
                <div style="font-size: 11px; margin: 4px 0;">TU ID: <span id="lobby-id" style="color:#6be0ff;">Generando...</span></div>
                <input type="text" id="connect-id" class="input-flat" placeholder="ID de tu amigo">
                <button onclick="game.networkModule.connectToPeer()">Enlazar</button>
            </div>

            <div class="panel">
                <div>ESTAMINA:<div class="bar-outer"><div id="stamina-bar" class="bar-inner"></div></div></div>
                <div>CORDURA:<div class="bar-outer"><div id="sanity-bar" class="bar-inner"></div></div></div>
                <div>LINTERNA:<div class="bar-outer"><div id="battery-bar" class="bar-inner"></div></div></div>
            </div>
        </div>

        <div id="crosshair"></div>

        <div style="display: flex; justify-content: space-between; align-items: flex-end; width: 100%; pointer-events: none;">
            <div class="panel">
                <div style="font-size: 15px; font-weight: bold;">NIVEL DE REALIDAD: <span id="lbl-level" style="color:#ffcc00;">0</span></div>
                <div style="font-size: 12px; color: #aaa; margin-top: 4px;">Paredes inestables detectadas. Intenta cruzar (NoClip).</div>
            </div>
            <div class="panel">
                <button onclick="game.stats.battery = 100;">Recargar Linterna</button>
            </div>
        </div>
    </div>

    <div id="vr-btn-container"></div>

    <script src="network.js"></script>
    <script src="maps.js"></script>
    <script src="main.js"></script>
</body>
</html>
