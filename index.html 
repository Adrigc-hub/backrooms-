<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>The Backrooms VR - 25 Levels Procedural</title>
    <style>
        body { margin: 0; padding: 0; overflow: hidden; background-color: #010103; font-family: 'Courier New', monospace; user-select: none; }
        #canvas-container { width: 100vw; height: 100vh; position: absolute; top: 0; left: 0; z-index: 1; }
        
        /* INTERFAZ DEL MENÚ PRINCIPAL */
        #main-menu { position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; background: radial-gradient(circle, #1a130b 0%, #030201 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 100; color: #d4b26f; }
        h1 { font-size: 3rem; margin-bottom: 5px; color: #e6b14a; letter-spacing: 5px; text-align: center; text-shadow: 0 0 10px rgba(230,177,74,0.3); }
        .subtitle { font-size: 0.9rem; margin-bottom: 30px; color: #8a734e; }
        .menu-container { display: flex; gap: 30px; width: 85%; max-width: 900px; justify-content: center; }
        .panel { background: rgba(10, 7, 4, 0.9); border: 2px solid #5c4a2b; padding: 20px; border-radius: 4px; box-shadow: 0 0 25px rgba(0,0,0,0.9); }
        .btn { background: #3a2e18; border: 1px solid #947745; color: #f7e6c4; padding: 12px 20px; font-size: 1rem; cursor: pointer; transition: all 0.2s ease; font-family: inherit; width: 100%; margin-top: 10px; }
        .btn:hover { background: #614e2b; color: #fff; box-shadow: 0 0 12px #947745; }
        
        /* HUD EN JUEGO */
        #hud { position: absolute; bottom: 20px; left: 20px; z-index: 10; color: #fff; pointer-events: none; display: none; }
        .hud-bar { background: rgba(5, 3, 1, 0.85); padding: 15px; border-radius: 4px; border-left: 4px solid #e6b14a; min-width: 240px; border-top: 1px solid #3a2e18; }
        .hud-line { margin: 5px 0; font-size: 1rem; text-shadow: 1px 1px 2px #000; }
        #crosshair { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 6px; height: 6px; background: rgba(255,255,255,0.5); border-radius: 50%; pointer-events: none; display: none; z-index: 5; }
        #game-alert { position: absolute; top: 30%; left: 50%; transform: translate(-50%, -50%); color: #ff3333; font-size: 1.8rem; font-weight: bold; text-align: center; z-index: 99; pointer-events: none; text-shadow: 0 0 10px #000; display: none; }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

    <div id="main-menu">
        <h1>THE BACKROOMS</h1>
        <div class="subtitle">MULTIPLAYER CO-OP // MOTOR PROCEDIMENTAL V2</div>
        
        <div class="menu-container">
            <div class="panel" style="flex: 1.2;">
                <div style="font-size: 1.1rem; margin-bottom: 10px; border-bottom: 1px solid #5c4a2b; padding-bottom: 5px;">SALA MULTIJUGADOR</div>
                <p style="color: #a89476; font-size: 0.85rem; line-height: 1.4;">Servidor cooperativo activo. Capacidad máxima: 5 exploradores. Modificaciones de físicas optimizadas para cascos VR.</p>
                <div style="margin: 15px 0; color: #00ff66; font-size: 0.9rem;">• ESTADO DEL SERVIDOR: CONECTADO (5/5)</div>
                <button class="btn" style="background: #5a1414; border-color: #ff4444; font-weight: bold;" onclick="enterBackrooms()">FORZAR NOCLIP</button>
            </div>

            <div class="panel" style="flex: 1;">
                <div style="font-size: 1.1rem; margin-bottom: 10px; border-bottom: 1px solid #5c4a2b; padding-bottom: 5px;">TIENDA EXTRA</div>
                <div class="hud-line">Dinero: <span id="shop-cash" style="color:#e6b14a;">$0</span></div>
                <div class="hud-line">Agua: <span id="shop-almonds" style="color:#00ffff;">0 uds</span></div>
                <button class="btn" style="font-size:0.85rem;" onclick="buyItem(150)">Linterna de Litio ($150)</button>
                <button class="btn" style="font-size:0.85rem;" onclick="buyItem(400)">Escáner de Entidades ($400)</button>
            </div>
        </div>
    </div>

    <div id="hud">
        <div class="hud-bar">
            <div class="hud-line" style="font-weight: bold; color: #ffcc00;" id="hud-level">NIVEL 0: LIMINAL SPACES</div>
            <div class="hud-line">Cordura: <span id="hud-sanity" style="color: #00ff66;">100%</span></div>
            <div class="hud-line">Botellas: <span id="hud-water" style="color: #00ffff;">0</span></div>
            <div class="hud-line">Cartera: <span id="hud-cash" style="color: #e6b14a;">$0</span></div>
            <div class="hud-line" id="stair-counter" style="display:none; color:#ff3333; font-weight:bold;">Escalones: <span id="stair-val">0</span>/50</div>
        </div>
    </div>

    <div id="crosshair"></div>
    <div id="game-alert"></div>
    <div id="canvas-container"></div>

    <script>
        let scene, camera, renderer;
        let currentLevel = 0;
        let sanity = 100;
        let cash = 0;
        let almonds = 0;
        let objectsStructure = [];
        let entities = [];
        let netPlayers = [];
        
        // Configuración de movimiento básica integrada para PC/VR sin bugs de librerías bloqueadas
        let moveKeys = { Forward: false, Backward: false, Left: false, Right: false };
        let playerVelocity = new THREE.Vector3();
        let clock = new THREE.Clock();
        
        // Rompecabezas del Nivel 24
        let stairsCount = 0;
        let isInStairs = false;

        // Generador matemático de texturas en tiempo real (Simulación de Blender procedural)
        function createBackroomsTexture(type) {
            const canvas = document.createElement('canvas');
            canvas.width = 256;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');

            if (type === 'wall') {
                // Papel tapiz amarillo sucio con ruido degradado
                ctx.fillStyle = '#ccb77e';
                ctx.fillRect(0, 0, 256, 256);
                ctx.fillStyle = '#b39f66';
                for (let i = 0; i < 400; i++) {
                    ctx.fillRect(Math.random() * 256, Math.random() * 256, 2, 8);
                }
            } else if (type === 'floor') {
                // Alfombra húmeda texturizada vieja
                ctx.fillStyle = '#82734e';
                ctx.fillRect(0, 0, 256, 256);
                ctx.fillStyle = '#615536';
                for (let i = 0; i < 2000; i++) {
                    ctx.fillRect(Math.random() * 256, Math.random() * 256, 2, 2);
                }
            } else if (type === 'kitty') {
                // Textura rosa pastel lisa para el nivel de Kitty
                ctx.fillStyle = '#ffccd5';
                ctx.fillRect(0, 0, 256, 256);
            } else {
                ctx.fillStyle = '#3a3a3a';
                ctx.fillRect(0, 0, 256, 256);
            }

            const texture = new THREE.CanvasTexture(canvas);
            texture.wrapS = THREE.RepeatWrapping;
            texture.wrapT = THREE.RepeatWrapping;
            return texture;
        }

        const levelsConfig = {
            0: { name: "Nivel 0: Tutorial Liminal", tex: 'wall', fColor: 0x6e6144, entities: ['Smiler'], density: 14 },
            1: { name: "Nivel 1: Zona de Carga", tex: 'grid', fColor: 0x444444, entities: ['Bacteria'], density: 16 },
            10: { name: "Nivel Kitty: Espacio Seguro(?)", tex: 'kitty', fColor: 0xffb6c1, entities: ['Kitty Entity'], density: 4 },
            24: { name: "Nivel Final: Las Escaleras Infinitas", tex: 'grid', fColor: 0x120f0c, entities: ['The King'], density: 1 }
        };

        // Llenar dinámicamente el resto de los 25 niveles para evitar saltos en la matriz
        for(let i=0; i<25; i++) {
            if(!levelsConfig[i]) {
                levelsConfig[i] = { name: `Nivel ${i}: Profundidades`, tex: 'wall', fColor: 0x3d3525, entities: ['Smiler', 'Bacteria'], density: 15 };
            }
        }

        window.buyItem = function(cost) {
            if(cash >= cost) { cash -= cost; updateUI(); alert("¡Objeto equipado para tu avatar VR!"); }
            else { alert("Fondos insuficientes."); }
        };

        function updateUI() {
            document.getElementById('shop-cash').innerText = "$" + cash;
            document.getElementById('shop-almonds').innerText = almonds + " uds";
            document.getElementById('hud-cash').innerText = "$" + cash;
            document.getElementById('hud-water').innerText = almonds;
        }

        window.enterBackrooms = function() {
            document.getElementById('main-menu').style.display = 'none';
            document.getElementById('hud').style.display = 'block';
            document.getElementById('crosshair').style.display = 'block';
            
            initGameEngine();
            buildProceduralLevel(currentLevel);
            animateLoop();
        };

        function initGameEngine() {
            const container = document.getElementById('canvas-container');
            
            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 500);
            camera.position.set(0, 1.6, 0);

            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.xr.enabled = true; // Soporte nativo para mandos y cascos WebXR
            container.appendChild(renderer.domElement);

            // Setup de controles integrados robustos
            window.addEventListener('keydown', (e) => {
                if(e.code === 'KeyW' || e.code === 'ArrowUp') moveKeys.Forward = true;
                if(e.code === 'KeyS' || e.code === 'ArrowDown') moveKeys.Backward = true;
                if(e.code === 'KeyA' || e.code === 'ArrowLeft') moveKeys.Left = true;
                if(e.code === 'KeyD' || e.code === 'ArrowRight') moveKeys.Right = true;
            });
            window.addEventListener('keyup', (e) => {
                if(e.code === 'KeyW' || e.code === 'ArrowUp') moveKeys.Forward = false;
                if(e.code === 'KeyS' || e.code === 'ArrowDown') moveKeys.Backward = false;
                if(e.code === 'KeyA' || e.code === 'ArrowLeft') moveKeys.Left = false;
                if(e.code === 'KeyD' || e.code === 'ArrowRight') moveKeys.Right = false;
            });

            // Rotación por arrastre de pantalla (Soporte móvil/PC/VR directo)
            let isDragging = false;
            window.addEventListener('mousedown', () => isDragging = true);
            window.addEventListener('mouseup', () => isDragging = false);
            window.addEventListener('mousemove', (e) => {
                if(isDragging) {
                    camera.rotation.y -= e.movementX * 0.003;
                }
            });

            // Inyectar clones del equipo del server de 5 personas
            for(let p=0; p<4; p++) {
                let mate = new THREE.Mesh(new THREE.BoxGeometry(0.5, 1.6, 0.5), new THREE.MeshStandardMaterial({color: 0x947745}));
                mate.position.set((Math.random()*4)-2, 0.8, (Math.random()*4)-2);
                scene.add(mate);
                netPlayers.push(mate);
            }
        }

        function buildProceduralLevel(idx) {
            objectsStructure.forEach(obj => scene.remove(obj));
            entities.forEach(ent => scene.remove(ent.mesh));
            objectsStructure = [];
            entities = [];

            const lvl = levelsConfig[idx];
            document.getElementById('hud-level').innerText = lvl.name.toUpperCase();
            
            scene.background = new THREE.Color(lvl.fColor);
            scene.fog = new THREE.FogExp2(lvl.fColor, 0.08);

            const ambientLight = new THREE.AmbientLight(0xffffff, 0.2);
            scene.add(ambientLight);
            objectsStructure.push(ambientLight);

            const pointLight = new THREE.PointLight(0xfffee0, 1.0, 25);
            pointLight.position.set(0, 3.5, 0);
            scene.add(pointLight);
            objectsStructure.push(pointLight);

            // MANEJO MECÁNICO DEL NIVEL 24 (ESCALERAS INFINITAS)
            if(idx === 24) {
                isInStairs = true;
                stairsCount = 0;
                document.getElementById('stair-counter').style.display = 'block';
                document.getElementById('stair-val').innerText = "0";
                
                // Geometría helicoidal vertical
                const stepGeo = new THREE.BoxGeometry(4, 0.2, 1.2);
                const stepMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1a });
                for(let i=0; i<60; i++) {
                    let step = new THREE.Mesh(stepGeo, stepMat);
                    let angle = i * 0.35;
                    step.position.set(Math.cos(angle)*3.5, i * 0.28, Math.sin(angle)*3.5);
                    step.rotation.y = -angle;
                    scene.add(step);
                    objectsStructure.push(step);
                }

                // Centro de salto al vacío
                let escapeAbyss = new THREE.Mesh(new THREE.CylinderGeometry(1.5, 1.5, 0.2), new THREE.MeshBasicMaterial({color: 0x000000}));
                escapeAbyss.position.set(0, 0, 0);
                escapeAbyss.name = "void_center";
                scene.add(escapeAbyss);
                objectsStructure.push(escapeAbyss);

                camera.position.set(3.5, 0.6, 0);
                return;
            } else {
                isInStairs = false;
                document.getElementById('stair-counter').style.display = 'none';
            }

            // Texturizado Algorítmico Avanzado en Muros y Pisos
            const wallTexture = createBackroomsTexture(lvl.tex);
            const floorTexture = createBackroomsTexture('floor');

            const wallMat = new THREE.MeshStandardMaterial({ map: wallTexture, roughness: 0.7 });
            const floorMat = new THREE.MeshStandardMaterial({ map: floorTexture, roughness: 0.9 });

            // Piso y Techo liminales
            const floor = new THREE.Mesh(new THREE.PlaneGeometry(100, 100), floorMat);
            floor.rotation.x = -Math.PI / 2;
            scene.add(floor);
            objectsStructure.push(floor);

            // Construcción del Laberinto Aleatorio Procedimental
            const size = 20;
            const boxGeo = new THREE.BoxGeometry(3, 4, 3);
            for(let x=0; x<size; x++) {
                for(let z=0; z<size; z++) {
                    if(x===0 || x===size-1 || z===0 || z===size-1 || (Math.random() > 0.78 && (x>2 || z>2))) {
                        let wall = new THREE.Mesh(boxGeo, wallMat);
                        wall.position.set((x - size/2)*3, 2, (z - size/2)*3);
                        scene.add(wall);
                        objectsStructure.push(wall);
                    }
                }
            }

            // Spawn de Botellas de Agua de Almendras recolectables
            for(let b=0; b<8; b++) {
                let bottle = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 0.3), new THREE.MeshStandardMaterial({color: 0x00ffff, emissive: 0x003333}));
                bottle.position.set((Math.random()*30 - 15), 0.15, (Math.random()*30 - 15));
                bottle.name = "almond_water";
                scene.add(bottle);
                objectsStructure.push(bottle);
            }

            // Zona invisible de noclip para avanzar entre mapas
            let noclipTrigger = new THREE.Mesh(new THREE.BoxGeometry(1, 2, 1), new THREE.MeshBasicMaterial({visible: false}));
            noclipTrigger.position.set((Math.random()*20 - 10), 1, (Math.random()*20 - 10));
            noclipTrigger.name = "noclip_gate";
            scene.add(noclipTrigger);
            objectsStructure.push(noclipTrigger);

            // Inyección de Entidades del Nivel
            lvl.entities.forEach(type => {
                let entMesh = new THREE.Mesh(
                    type === 'Kitty Entity' ? new THREE.CylinderGeometry(0.05, 0.05, 3.8) : new THREE.BoxGeometry(0.5, 1.7, 0.5),
                    new THREE.MeshBasicMaterial({color: type === 'Kitty Entity' ? 0x070707 : 0x111111})
                );
                entMesh.position.set((Math.random()*20 - 10), type === 'Kitty Entity' ? 1.9 : 0.85, (Math.random()*20 - 10));
                scene.add(entMesh);
                entities.push({ mesh: entMesh, type: type, dir: new THREE.Vector3(Math.random()-0.5, 0, Math.random()-0.5).normalize() });
            });

            camera.position.set(0, 1.6, 0);
        }

        function triggerAlert(msg, color = "#ff3333") {
            const el = document.getElementById('game-alert');
            el.innerText = msg; el.style.color = color; el.style.display = 'block';
            setTimeout(() => el.style.display = 'none', 3500);
        }

        function animateLoop() {
            renderer.setAnimationLoop(animateLoop);
            const delta = clock.getDelta();
            const time = performance.now();

            // --- LÓGICA DE MOVIMIENTO DE JUGADOR ---
            playerVelocity.set(0, 0, 0);
            const speed = 4.5;
            
            // Vectores de dirección basados en la cámara del casco u ojos del jugador
            const forward = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion);
            const right = new THREE.Vector3(1, 0, 0).applyQuaternion(camera.quaternion);
            forward.y = 0; right.y = 0;
            forward.normalize(); right.normalize();

            if(moveKeys.Forward) camera.position.addScaledVector(forward, speed * delta);
            if(moveKeys.Backward) camera.position.addScaledVector(forward, -speed * delta);
            if(moveKeys.Left) camera.position.addScaledVector(right, -speed * delta);
            if(moveKeys.Right) camera.position.addScaledVector(right, speed * delta);

            if(!isInStairs && camera.position.y !== 1.6) camera.position.y = 1.6;

            const pos = camera.position;

            // --- LÓGICA ESPECÍFICA DE LAS ESCALERAS DEL ENIGMA (NIVEL 24) ---
            if(isInStairs) {
                let currentStep = Math.floor(pos.y / 0.28);
                if(currentStep > stairsCount && currentStep <= 50) {
                    stairsCount = currentStep;
                    document.getElementById('stair-val').innerText = stairsCount;
                    if(stairsCount === 50) triggerAlert("¡ESCALÓN 50! ¡SALTA AL CENTRO AHORA MISMO!", "#00ff66");
                }

                // Caída al centro del vacío
                if(pos.y > 10 && Math.abs(pos.x) < 1.3 && Math.abs(pos.z) < 1.3) {
                    if(stairsCount >= 50) {
                        triggerAlert("¡LOGRASTE ESCAPAR DE LOS BACKROOMS!", "#00ff66");
                        cash += 2000; almonds += 5; updateUI();
                        setTimeout(() => window.location.reload(), 4500);
                    } else {
                        triggerAlert("¡CONTEO INCORRECTO! Regresando al inicio del Laberinto con tu equipo.");
                        currentLevel = 0;
                        buildProceduralLevel(currentLevel);
                    }
                }
            }

            // --- INTERSECCIONES, RECURSOS Y NOCLIP EN TIEMPO REAL ---
            for(let i = objectsStructure.length - 1; i >= 0; i--) {
                let obj = objectsStructure[i];
                if(!obj.name) continue;
                let d = pos.distanceTo(obj.position);

                if(obj.name === "almond_water" && d < 1.0) {
                    scene.remove(obj); objectsStructure.splice(i, 1);
                    almonds++; cash += 150; updateUI();
                    triggerAlert("+1 Agua de Almendras extra ($150)", "#00ffff");
                }

                if(obj.name === "noclip_gate" && d < 1.2) {
                    if(currentLevel < 24) {
                        currentLevel++;
                        triggerAlert(`¡NOCLIP EXITOSO! Pasando al mapa ${currentLevel}`, "#ffaa00");
                        buildProceduralLevel(currentLevel);
                    }
                }
            }

            // Movimiento de fantasmas del equipo multijugador simulado
            netPlayers.forEach((p, idx) => {
                p.position.x += Math.sin(time*0.001 + idx)*delta*1.5;
                p.position.z += Math.cos(time*0.0012 + idx)*delta*1.5;
            });

            // Patrullaje de Entidades y drenado de cordura
            entities.forEach(ent => {
                ent.mesh.position.addScaledVector(ent.dir, 1.8 * delta);
                if(Math.abs(ent.mesh.position.x) > 25 || Math.abs(ent.mesh.position.z) > 25) ent.dir.negate();

                if(pos.distanceTo(ent.mesh.position) < 3.2) {
                    sanity = Math.max(0, sanity - 20 * delta);
                    document.getElementById('hud-sanity').innerText = Math.floor(sanity) + "%";
                    if(sanity <= 0) {
                        triggerAlert("PERDISTE LA CORDURA... FIN DE LA TRANSMISIÓN");
                        setTimeout(() => window.location.reload(), 3000);
                    }
                }
            });

            renderer.render(scene, camera);
        }

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>
