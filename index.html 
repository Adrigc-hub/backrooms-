<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>THE BACKROOMS: SIMULATION REALITY COLLAPSE (MULTIPLAYER AAA)</title>
    <style>
        /* ============================================================================
           ESTILOS MAESTROS Y ELEMENTOS DE INTERFAZ (HUD)
           ============================================================================ */
        body, html {
            margin: 0;
            padding: 0;
            overflow: hidden;
            background-color: #020202;
            font-family: 'Courier New', Courier, monospace;
            user-select: none;
            width: 100vw;
            height: 100vh;
        }
        #game-canvas {
            width: 100%;
            height: 100%;
            display: block;
        }
        #hud-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 25px;
            box-sizing: border-box;
            color: #ebdcb2;
            text-shadow: 2px 2px 4px #000, 0 0 10px rgba(0,0,0,0.8);
            z-index: 10;
        }
        .panel {
            background: linear-gradient(135deg, rgba(18, 18, 12, 0.92) 0%, rgba(10, 10, 5, 0.96) 100%);
            border: 2px solid #7d6b47;
            padding: 15px;
            border-radius: 6px;
            pointer-events: auto;
            box-shadow: 0 10px 25px rgba(0,0,0,0.7), inset 0 0 15px rgba(125,107,71,0.15);
        }
        .stats-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
            min-width: 240px;
        }
        .bar-container {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .bar-label {
            font-size: 11px;
            font-weight: bold;
            letter-spacing: 1px;
        }
        .bar-outer {
            width: 100%;
            height: 12px;
            background: #1a1a14;
            border: 1px solid #54472f;
            border-radius: 2px;
            overflow: hidden;
            position: relative;
            box-shadow: inset 0 0 5px #000;
        }
        .bar-inner {
            height: 100%;
            width: 100%;
            transition: width 0.1s linear, background-color 0.3s ease;
        }
        #stamina-bar { background: #2cd6a1; box-shadow: 0 0 8px rgba(44,214,161,0.4); }
        #sanity-bar { background: #ff4747; box-shadow: 0 0 8px rgba(255,71,71,0.4); }
        #battery-bar { background: #ffcc00; box-shadow: 0 0 8px rgba(255,204,0,0.4); }
        
        .input-flat {
            background: #14140f;
            border: 1px solid #7d6b47;
            color: #fff;
            padding: 8px;
            font-family: monospace;
            border-radius: 4px;
            width: 140px;
            outline: none;
        }
        .input-flat:focus {
            border-color: #ebdcb2;
            box-shadow: 0 0 5px rgba(235,220,178,0.5);
        }
        button {
            background: #7d6b47;
            color: #fff;
            border: 1px solid #ebdcb2;
            padding: 8px 14px;
            cursor: pointer;
            font-family: monospace;
            font-weight: bold;
            border-radius: 4px;
            transition: all 0.2s ease;
        }
        button:hover {
            background: #ebdcb2;
            color: #000;
            box-shadow: 0 0 10px rgba(235,220,178,0.4);
        }
        #crosshair {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 6px;
            height: 6px;
            background: rgba(255,255,255,0.35);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            transition: scale 0.1s ease;
        }
        #vr-btn-container {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 100;
        }
        /* Estilos de la Terminal de la Tienda In-Game */
        .shop-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 8px;
        }
        .log-box {
            background: rgba(0,0,0,0.5);
            border: 1px solid #3d331e;
            padding: 6px;
            height: 60px;
            overflow-y: hidden;
            font-size: 11px;
            color: #a39674;
            margin-top: 8px;
            border-radius: 3px;
        }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/webxr/VRButton.js"></script>
    <script src="https://unpkg.com/peerjs@1.4.7/dist/peerjs.min.js"></script>
</head>
<body>

    <canvas id="game-canvas"></canvas>

    <div id="hud-layer">
        <div style="display: flex; justify-content: space-between; width: 100%; pointer-events: none;">
            <div class="panel">
                <div style="font-weight: bold; font-size: 16px; margin-bottom: 5px; color:#ffcc00; letter-spacing: 1px;">SALA MULTIJUGADOR</div>
                <div>TU ID DE RED: <span id="lobby-id" style="color:#6be0ff; font-weight:bold;">Sincronizando...</span></div>
                <div style="margin-top: 8px; display: flex; gap: 6px; pointer-events: auto;">
                    <input type="text" id="connect-id" class="input-flat" placeholder="ID del Explorador">
                    <button onclick="game.networkModule.connectToPeer()">Vincular</button>
                </div>
                <div class="log-box" id="net-logs">Sincronizando canales cuánticos... Listo.</div>
            </div>

            <div class="panel stats-grid">
                <div class="bar-container">
                    <div class="bar-label">ESTAMINA FÍSICA (<span id="txt-stamina">100</span>%)</div>
                    <div class="bar-outer"><div id="stamina-bar" class="bar-inner"></div></div>
                </div>
                <div class="bar-container">
                    <div class="bar-label">ESTABILIDAD MENTAL (<span id="txt-sanity">100</span>%)</div>
                    <div class="bar-outer"><div id="sanity-bar" class="bar-inner"></div></div>
                </div>
                <div class="bar-container">
                    <div class="bar-label">CELDA DE LINTERNA (<span id="txt-battery">100</span>%)</div>
                    <div class="bar-outer"><div id="battery-bar" class="bar-inner"></div></div>
                </div>
            </div>
        </div>

        <div id="crosshair"></div>

        <div style="display: flex; justify-content: space-between; align-items: flex-end; width: 100%; pointer-events: none;">
            <div class="panel" style="max-width: 350px;">
                <div style="font-size: 15px; font-weight: bold; color: #ebdcb2;">NIVEL DE REALIDAD: <span id="lbl-level" style="color:#ffcc00;">0</span></div>
                <div style="margin: 6px 0;">RECOMPENSAS: <span style="color:#6bff84; font-weight:bold;">$<span id="lbl-money">0</span></span></div>
                <div style="border-top: 1px solid #3d331e; padding-top: 6px; font-size: 12px;">
                    <b>OBJETIVO:</b> <span id="lbl-mission" style="color: #fff;">Explora las anomalías del terreno para forzar un NoClip dimensional.</span>
                </div>
            </div>

            <div class="panel" style="min-width: 280px;">
                <div style="font-weight: bold; font-size: 13px; text-align: center; border-bottom: 1px solid #7d6b47; padding-bottom: 4px; color: #ffcc00;">SUMINISTROS DE ASYNC</div>
                <div class="shop-grid">
                    <button onclick="game.economyModule.buyItem('battery')">Batería ($20)</button>
                    <button onclick="game.economyModule.buyItem('water')">Agua Almendra ($35)</button>
                </div>
            </div>
        </div>
    </div>

    <div id="vr-btn-container"></div>

    <script>
        // ============================================================================
        // MÓDULO DE RED MULTIJUGADOR PEER-TO-PEER (P2P COOP)
        // ============================================================================
        class NetworkModule {
            constructor(gameEngine) {
                this.game = gameEngine;
                this.peer = null;
                this.connections = [];
                this.logElement = document.getElementById('net-logs');
                this.idElement = document.getElementById('lobby-id');
                
                this.initPeer();
            }

            initPeer() {
                // Instanciar conexión PeerJS usando brokers públicos globales para navegadores
                this.peer = new Peer(null, {
                    debug: 1
                });

                this.peer.on('open', (id) => {
                    this.idElement.innerText = id;
                    this.addLog("Canal abierto. Comparte tu ID con tu compañero.");
                });

                this.peer.on('connection', (conn) => {
                    this.handleIncomingConnection(conn);
                });

                this.peer.on('error', (err) => {
                    this.addLog("Error de enlace cuántico: " + err.type);
                    console.error(err);
                });
            }

            connectToPeer() {
                let targetId = document.getElementById('connect-id').value.trim();
                if (!targetId) return;
                
                this.addLog(`Intentando enlazar con: ${targetId}...`);
                let conn = this.peer.connect(targetId, {
                    serialization: 'json'
                });
                
                this.handleIncomingConnection(conn);
            }

            handleIncomingConnection(conn) {
                conn.on('open', () => {
                    this.addLog(`¡Explorador conectado de forma segura!`);
                    this.connections.push(conn);
                    this.game.spawnRemotePlayer(conn.peer);
                });

                conn.on('data', (data) => {
                    this.processNetworkData(conn.peer, data);
                });

                conn.on('close', () => {
                    this.addLog(`Se ha perdido la señal de un explorador.`);
                    this.game.removeRemotePlayer(conn.peer);
                    this.connections = this.connections.filter(c => c.peer !== conn.peer);
                });
            }

            broadcastData(data) {
                for (let i = 0; i < this.connections.length; i++) {
                    if (this.connections[i].open) {
                        this.connections[i].send(data);
                    }
                }
            }

            processNetworkData(peerId, data) {
                if (data.type === 'transform') {
                    this.game.updateRemotePlayerTransform(peerId, data);
                } else if (data.type === 'noclip') {
                    this.addLog(`Un explorador alteró la realidad hacia el Nivel ${data.level}`);
                    this.game.levelModule.loadLevel(data.level, true);
                }
            }

            addLog(text) {
                this.logElement.innerText = text;
            }
        }
