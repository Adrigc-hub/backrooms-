<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>THE BACKROOMS: LORE ACCURATE PROTOCOL</title>
    <style>
        body, html { margin: 0; padding: 0; overflow: hidden; background-color: #050503; font-family: 'Courier New', monospace; user-select: none; width: 100vw; height: 100vh; }
        #game-canvas { width: 100%; height: 100%; display: block; }
        #hud-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; display: flex; flex-direction: column; justify-content: space-between; padding: 20px; box-sizing: border-box; color: #ebdcb2; text-shadow: 2px 2px 3px #000; z-index: 10; }
        .panel { background: rgba(12, 12, 8, 0.93); border: 2px solid #5c4e35; padding: 12px; border-radius: 4px; pointer-events: auto; }
        .bar-outer { width: 160px; height: 10px; background: #141410; border: 1px solid #423826; margin-top: 4px; overflow: hidden; }
        .bar-inner { height: 100%; width: 100%; transition: width 0.1s linear; }
        #stamina-bar { background: #3adeb4; }
        #sanity-bar { background: #de3a3a; }
        #battery-bar { background: #ded03a; }
        .input-flat { background: #0f0f0c; border: 1px solid #5c4e35; color: #fff; padding: 6px; font-family: monospace; width: 110px; text-transform: uppercase; }
        button { background: #5c4e35; color: #fff; border: 1px solid #ebdcb2; padding: 6px 12px; cursor: pointer; font-family: monospace; font-weight: bold; }
        button:hover { background: #ebdcb2; color: #000; }
        #crosshair { position: absolute; top: 50%; left: 50%; width: 4px; height: 4px; background: rgba(255,255,255,0.4); border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; }
        #vr-btn-container { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); z-index: 100; }
        #escape-alert { position: absolute; top: 30%; left: 50%; transform: translate(-50%, -50%); background: rgba(255,0,0,0.85); color: white; padding: 15px; border: 2px solid white; font-weight: bold; display: none; z-index: 20; }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/webxr/VRButton.js"></script>
    <script src="https://unpkg.com/peerjs@1.4.7/dist/peerjs.min.js"></script>
</head>
<body>

    <canvas id="game-canvas"></canvas>
    <div id="escape-alert">¡NO-CLIP CRÍTICO SELECCIONADO! ESCAPANDO DE LA REALIDAD...</div>

    <div id="hud-layer">
        <div style="display: flex; justify-content: space-between; width: 100%; pointer-events: none;">
            <div class="panel">
                <div style="font-weight: bold; color:#ffcc00; font-size:12px;">ASYNC COOP (MÁX 5)</div>
                <div style="font-size: 10px; margin: 4px 0;">ID CANAL: <span id="lobby-id" style="color:#6be0ff;">...</span></div>
                <input type="text" id="connect-id" class="input-flat" placeholder="ID AMIGO">
                <button onclick="game.networkModule.connectToPeer()">ENLAZAR</button>
            </div>

            <div class="panel" style="font-size: 11px;">
                <div>ESTAMINA:<div class="bar-outer"><div id="stamina-bar" class="bar-inner"></div></div></div>
                <div>CORDURA:<div class="bar-outer"><div id="sanity-bar" class="bar-inner"></div></div></div>
                <div>BATERÍA :<div class="bar-outer"><div id="battery-bar" class="bar-inner"></div></div></div>
            </div>
        </div>

        <div id="crosshair"></div>

        <div style="display: flex; justify-content: space-between; align-items: flex-end; width: 100%; pointer-events: none;">
            <div class="panel" style="max-width: 400px;">
                <div style="font-size: 14px; font-weight: bold;">NIVEL ACTUAL: <span id="lbl-level" style="color:#ffcc00;">0</span></div>
                <div style="font-size: 11px; color: #d4c296; margin-top: 4px;"><b>ESTADO:</b> <span id="lbl-mission">Busca una falla estructural en el tapiz húmedo.</span></div>
            </div>
            <div class="panel">
                <button onclick="game.stats.battery = 100; game.stats.sanity = Math.min(100, game.stats.sanity + 20);">TOMAR AGUA DE ALMENDRA</button>
            </div>
        </div>
    </div>

    <div id="vr-btn-container"></div>

    <script src="network.js"></script>
    <script src="maps.js"></script>
    <script src="main.js"></script>
</body>
</html>
