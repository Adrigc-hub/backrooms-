<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Backrooms: GitHub Edition</title>
    <style>
        body { margin: 0; overflow: hidden; background: #000; font-family: monospace; color: #fff; }
        #menu, #shop { position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(20,20,10,0.95); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 10; }
        .hidden { display: none !important; }
        button { background: #443; color: #ff0; border: 2px solid #ff0; padding: 15px 30px; margin: 10px; cursor: pointer; font-family: monospace; font-size: 18px; }
        button:hover { background: #ff0; color: #000; }
        #hud { position: absolute; bottom: 20px; left: 20px; z-index: 5; font-size: 20px; color: #ff0; text-shadow: 2px 2px #000; pointer-events: none; }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    </head>
<body>

    <div id="menu">
        <h1>THE BACKROOMS</h1>
        <p>Gráficos retro/bajos activados para máxima distorsión cognitiva.</p>
        <button onclick="startGame()">INGRESAR AL ARCHIVO (JUGAR)</button>
        <button onclick="toggleShop(true)">TIENDA DEL PISO</button>
        <div id="multiplayer-status">Conectando a servidores de GitHub (5/5 en lobby virtual)...</div>
    </div>

    <div id="shop" class="hidden">
        <h1>TIENDA DE SUPERVIVENCIA</h1>
        <p>Dinero disponible: $<span id="money-count">0</span></p>
        <button onclick="buyItem('linterna', 50)">Linterna de Alta Densidad ($50)</button>
        <button onclick="buyItem('agua', 30)">Agua de Almendras (Anti-Cordura) ($30)</button>
        <button onclick="buyItem('brujula', 100)">Escáner de Noclip ($100)</button>
        <br>
        <button onclick="toggleShop(false)">VOLVER</button>
    </div>

    <div id="hud" class="hidden">
        Nivel: <span id="hud-level">0</span> | Dinero: $<span id="hud-money">0</span> | Escalones: <span id="hud-steps">0/50</span>
        <br><small>Controles: WASD/Flechas para mover. Click para Noclip. (Soporte VR Automático)</small>
    </div>

    <script>
        // --- VARIABLES GLOBALES DE JUEGO ---
        let scene, camera, renderer, player;
        let currentLevel = 0;
        let money = 0;
        let stepsCount = 0;
        let inventory = { linterna: false, agua: false, brujula: false };
        
        // Audio Sintetizado (Sin archivos externos para que funcione 100% en GitHub)
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        
        function playZumbido() {
            // El clásico zumbido de las luces fluorescentes del Nivel 0
            let osc = audioCtx.createOscillator();
            let gain = audioCtx.createGain();
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(60, audioCtx.currentTime); // 60Hz hum
            gain.gain.setValueAtTime(0.02, audioCtx.currentTime);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
        }

        function playGlitchSound() {
            let osc = audioCtx.createOscillator();
            let gain = audioCtx.createGain();
            osc.type = 'square';
            osc.frequency.setValueAtTime(Math.random() * 800 + 200, audioCtx.currentTime);
            gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.1);
        }

        // --- TIENDA Y LOGICA ---
        function toggleShop(open) {
            document.getElementById('menu').className = open ? 'hidden' : '';
            document.getElementById('shop').className = open ? '' : 'hidden';
            document.getElementById('money-count').innerText = money;
        }

        function buyItem(item, cost) {
            if (money >= cost && !inventory[item]) {
                money -= cost;
                inventory[item] = true;
                document.getElementById('money-count').innerText = money;
                alert("Compraste: " + item);
            } else {
                alert("Dinero insuficiente o ya tienes este objeto.");
            }
        }

        // --- INICIALIZACIÓN DEL JUEGO 3D ---
        function startGame() {
            document.getElementById('menu').className = 'hidden';
            document.getElementById('hud').className = '';
            playZumbido();
            init3D();
        }

        function init3D() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x111105);
            scene.fog = new THREE.FogExp2(0x111105, 0.15); // Niebla para ocultar malos gráficos y dar miedo

            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            renderer = new THREE.WebGLRenderer({ antialias: false }); // Antialias false para gráficos pixelados/viejos
            renderer.setSize(window.innerWidth, window.innerHeight);
            document.body.appendChild(renderer.domElement);

            // Habilitar WebXR para Oculus/Meta Quest
            renderer.xr.enabled = true;
            document.body.appendChild(THREE.WEBXR.createButton(renderer)); 

            generateProceduralLevel();

            // Controles básicos PC/Celular
            window.addEventListener('keydown', handleMovement);
            window.addEventListener('click', intentarNoclip); // Click/Tap para forzar noclip en móvil o PC

            animate();
        }

        // --- GENERACIÓN ALEATORIA DE HABITACIONES (15 NIVELES) ---
        function generateProceduralLevel() {
            // Limpiar nivel anterior
            while(scene.children.length > 0){ 
                scene.remove(scene.children[0]); 
            }

            document.getElementById('hud-level').innerText = currentLevel;
            document.getElementById('hud-money').innerText = money;

            // Iluminación decadente
            let light = new THREE.PointLight(0xfffee0, 1, 50);
            light.position.set(0, 4, 0);
            scene.add(light);

            if (currentLevel === 14) {
                // NIVEL FINAL: LOS ESCALONES INFINITOS (Nivel 9223372036854775807 modificado)
                buildInfiniteStairs();
                return;
            }

            // Paredes alfombradas amarillas / texturas procedurales retro
            let wallGeo = new THREE.BoxGeometry(4, 5, 4);
            let wallMat = new THREE.MeshBasicMaterial({ color: 0x8c7c43 }); // Color "Moqueta Amarilla"

            // Generar laberinto aleatorio según el nivel
            for (let i = 0; i < 25; i++) {
                let wall = new THREE.Mesh(wallGeo, wallMat);
                wall.position.set((Math.random() - 0.5) * 40, 2.5, (Math.random() - 0.5) * 40);
                scene.add(wall);
            }

            // Piso
            let floorGeo = new THREE.PlaneGeometry(100, 100);
            let floorMat = new THREE.MeshBasicMaterial({ color: 0x5a4d22 });
            let floor = new THREE.Mesh(floorGeo, floorMat);
            floor.rotation.x = -Math.PI / 2;
            scene.add(floor);

            // Generar Entidad del nivel (Bacterias, Skin-Stealers, Smilers simulados en 3D pixelado)
            let entityGeo = new THREE.ConeGeometry(0.5, 2, 4);
            let entityMat = new THREE.MeshBasicMaterial({ color: 0x111111 });
            let entity = new THREE.Mesh(entityGeo, entityMat);
            entity.position.set((Math.random() - 0.5) * 20, 1, (Math.random() - 0.5) * 20);
            scene.add(entity);

            camera.position.set(0, 1.6, 5); // Altura de ojos humana
        }

        // --- MECÁNICA: NIVEL FINAL DE LOS ESCALONES ---
        function buildInfiniteStairs() {
            stepsCount = 0;
            document.getElementById('hud-steps').innerText = "0/50";
            
            let stairGeo = new THREE.BoxGeometry(5, 0.3, 1);
            let stairMat = new THREE.MeshBasicMaterial({ color: 0x222222 });

            for (let i = 0; i < 60; i++) {
                let stair = new THREE.Mesh(stairGeo, stairMat);
                stair.position.set(0, i * 0.3, -i * 1);
                scene.add(stair);
            }
            camera.position.set(0, 1.6, 0);
        }

        // --- LORE ACCURATE: 5 FORMAS DE NOCLIP / ESCAPES ---
        function intentarNoclip() {
            playGlitchSound();
            let chance = Math.random();
            
            // 5 Formas de Noclip (Interacciones aleatorias del entorno)
            if (chance < 0.2) { alert("¡Hiciste Noclip corriendo hacia una esquina bugeada!"); avanzarNivel(); }
            else if (chance < 0.4) { alert("El suelo se volvió blando. Atravesaste el código."); avanzarNivel(); }
            else if (chance < 0.6) { alert("Tocaste una pared con textura parpadeante."); avanzarNivel(); }
            else if (chance < 0.8) { alert("Te dormiste en el suelo y caíste al siguiente estrato."); avanzarNivel(); }
            else { alert("Una entidad te empujó fuera de los límites de colisión."); avanzarNivel(); }
        }

        function avanzarNivel() {
            money += 20 + (currentLevel * 5); // Más misiones/niveles = más dinero
            currentLevel++;
            if (currentLevel >= 15) currentLevel = 0; // Bucle o reinicio
            generateProceduralLevel();
        }

        // --- CONTROLES Y JUGABILIDAD (PC / MÓVIL / VR) ---
        function handleMovement(e) {
            let speed = 0.5;
            if (e.key === 'w' || e.key === 'ArrowUp') {
                camera.position.z -= speed;
                if(currentLevel === 14) contarEscalon();
            }
            if (e.key === 's' || e.key === 'ArrowDown') camera.position.z += speed;
            if (e.key === 'a' || e.key === 'ArrowLeft') camera.position.x -= speed;
            if (e.key === 'd' || e.key === 'ArrowRight') camera.position.x += speed;
        }

        function contarEscalon() {
            stepsCount++;
            document.getElementById('hud-steps').innerText = stepsCount + "/50";
            
            if (stepsCount >= 50) {
                // Lore: Tienes que saltar al medio (Vacío) para salir
                alert("¡Has contado 50 escalones! SALTA AL VACÍO (Presiona Espacio o click al centro) para escapar.");
                window.addEventListener('keydown', function(e) {
                    if(e.key === ' ') {
                        alert("¡LOGRASTE ESCAPAR DE LOS BACKROOMS! Volviendo a la realidad.");
                        money += 1000;
                        currentLevel = 0;
                        toggleShop(true);
                    }
                });
            }
            // Si te pasas de los 50 o fallas, vas al nivel opuesto (Nivel -1 o similar inferno)
            if (stepsCount > 55) {
                alert("Perdiste la cuenta... Caíste al nivel opuesto: ¡EL INFRAMUNDO!");
                currentLevel = 1; // Castigo
                generateProceduralLevel();
            }
        }

        // --- BUCLE DE RENDERIZADO ---
        function animate() {
            renderer.setAnimationLoop(() => {
                // Rotar entidades levemente para dar efecto tétrico
                scene.traverse(function (object) {
                    if (object.isMesh && object.geometry.type === "ConeGeometry") {
                        object.rotation.y += 0.05;
                        // Persecución inteligente simulada hacia la cámara
                        object.position.x += (camera.position.x - object.position.x) * 0.01;
                        object.position.z += (camera.position.z - object.position.z) * 0.01;
                    }
                });

                renderer.render(scene, camera);
            });
        }
    </script>
</body>
</html>
